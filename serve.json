    },
    {
      "source": "pt/studio/**",
      "destination": "/studio.html"
    },
    {
      "source": "es",
      "destination": "/index.html"
    },
    {
      "source": "es/docs",
      "destination": "/pages/docs.html"
    },
    {
      "source": "es/studio",
      "destination": "/studio.html"
    },
    {
      "source": "es/studio/**",
      "destination": "/studio.html"
